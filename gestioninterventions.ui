<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GestionInterventions</class>
 <widget class="QWidget" name="GestionInterventions">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1500</width><height>820</height></rect></property>
  <property name="windowTitle"><string>Gestion des interventions</string></property>
  <property name="styleSheet"><string notr="true">* { font-family: "Segoe UI", "Helvetica Neue", Arial; font-size: 13px; color: #1f2937; }
QWidget#GestionInterventions { background: #eef0f4; }
QFrame#centerFrame, QFrame#content { background: #eef0f4; border: none; }
QLabel { background: transparent; }

/* ---- Sidebar (image + voile rouge) ---- */
QFrame#sidebar { border-image: url(:/images/sidebar_bg.png) 0 0 0 0 stretch stretch; }
QFrame#sidebar QLabel { background: transparent; border: none; }
QFrame#sidebar QPushButton {
    background: transparent; color: #ffffff; border: none; border-left: 4px solid transparent;
    text-align: left; padding: 12px 18px 12px 22px; font-size: 14px; min-height: 22px;
}
QFrame#sidebar QPushButton:hover   { background: rgba(0,0,0,0.22); }
QFrame#sidebar QPushButton:checked { background: rgba(0,0,0,0.58); font-weight: bold; border-left: 4px solid #ffffff; }

/* ---- Barre du haut ---- */
QFrame#topBar { background: #eef0f4; border: none; }
QLineEdit#searchEdit {
    background: #e2e5ea url(:/icons/search.png) no-repeat left center;
    border: 1px solid #d5d9df; border-radius: 6px; padding: 8px 12px 8px 34px; min-width: 360px; max-width: 360px;
}
QPushButton#btnMenu, QPushButton#btnNotif, QPushButton#btnSettings, QPushButton#btnPower {
    background: transparent; border: none; padding: 6px; border-radius: 6px;
}
QPushButton#btnMenu:hover, QPushButton#btnNotif:hover, QPushButton#btnSettings:hover, QPushButton#btnPower:hover { background: #dfe3e8; }
QLabel#labelAdmin { font-weight: bold; font-size: 12px; color: #1f2937; }


/* ---- Titre ---- */
QLabel#labelTitle { font-size: 20px; font-weight: bold; color: #1f2937; padding: 4px 2px; }

/* ---- Cartes de synthèse (4 cartes de même largeur) ---- */
QFrame#cardTotal, QFrame#cardEnCours, QFrame#cardEnAttente, QFrame#cardTerminee {
    background: white; border: 1px solid #e3e6ea; border-radius: 8px;
}
QFrame#cardTotal     { border-left: 5px solid #1f2d3d; }
QFrame#cardEnCours   { border-left: 5px solid #f59e0b; }
QFrame#cardEnAttente { border-left: 5px solid #ef4444; }
QFrame#cardTerminee  { border-left: 5px solid #22c55e; }
QFrame#cardTotal QLabel, QFrame#cardEnCours QLabel, QFrame#cardEnAttente QLabel, QFrame#cardTerminee QLabel { border: none; }
QLabel#lblTotalTitle     { color: #1f2d3d; font-weight: bold; }
QLabel#lblEnCoursTitle   { color: #b45309; font-weight: bold; }
QLabel#lblEnAttenteTitle { color: #b91c1c; font-weight: bold; }
QLabel#lblTermineeTitle  { color: #15803d; font-weight: bold; }
QLabel#lblTotal, QLabel#lblEnCours, QLabel#lblEnAttente, QLabel#lblTerminee { font-size: 26px; font-weight: bold; }

/* ---- Barre d'outils : ligne 1 = actions, ligne 2 = affichage (filtres, tri, stats, PDF) ---- */
QFrame#actionsFrame { background: white; border: 1px solid #e3e6ea; border-radius: 8px; }
QFrame#actionsFrame QLabel { border: none; color: #6b7280; font-weight: 600; }
QFrame#sepToolbar { background: #eceef2; border: none; min-height: 1px; max-height: 1px; }
QLabel#lblFiltreStatut, QLabel#lblTri { padding-left: 10px; }
QLabel#lblCompte { font-weight: normal; padding-right: 6px; }

QFrame#actionsFrame QComboBox {
    background: white; border: 1px solid #cfd4da; border-radius: 6px; padding: 7px 10px; min-width: 150px; color: #1f2937;
}
QFrame#actionsFrame QComboBox:hover { border-color: #9aa3af; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 24px; }
QComboBox::down-arrow, QDateEdit::down-arrow { image: url(:/icons/chevron_down.png); width: 14px; height: 14px; }
QComboBox QAbstractItemView { background: white; selection-background-color: #fde2e2; selection-color: #1f2937; border: 1px solid #cfd4da; }

/* boutons : secondaire (blanc) par défaut */
QFrame#actionsFrame QPushButton {
    background: white; color: #1f2d3d; border: 1px solid #cfd4da; border-radius: 6px;
    padding: 8px 14px; font-weight: 600; min-height: 20px;
}
QFrame#actionsFrame QPushButton:hover    { background: #f3f4f6; border-color: #aab1bb; }
QFrame#actionsFrame QPushButton:pressed  { background: #e5e7eb; }
QFrame#actionsFrame QPushButton:focus    { border: 1px solid #1f2d3d; }
QFrame#actionsFrame QPushButton:disabled { background: #f3f4f6; color: #a3aab5; border-color: #e5e7eb; }

/* bouton principal : Ajouter */
QFrame#actionsFrame QPushButton#btnAjouter { background: #1f2d3d; color: white; border: 1px solid #1f2d3d; padding: 8px 20px; }
QFrame#actionsFrame QPushButton#btnAjouter:hover    { background: #2d4157; border-color: #2d4157; }
QFrame#actionsFrame QPushButton#btnAjouter:pressed  { background: #16212d; }
QFrame#actionsFrame QPushButton#btnAjouter:disabled { background: #c5ccd5; border-color: #c5ccd5; color: #f3f4f6; }

/* bouton destructif : Supprimer (rouge) */
QFrame#actionsFrame QPushButton#btnSupprimer { color: #b91c1c; border: 1px solid #f1b9b9; }
QFrame#actionsFrame QPushButton#btnSupprimer:hover    { background: #fef2f2; border-color: #b91c1c; }
QFrame#actionsFrame QPushButton#btnSupprimer:pressed  { background: #fee2e2; }
QFrame#actionsFrame QPushButton#btnSupprimer:disabled { background: #f3f4f6; color: #d3a9a9; border-color: #e5e7eb; }

/* tri : deux boutons collés (ID | Date), celui qui est actif est foncé */
QFrame#actionsFrame QPushButton#btnTriId   { border-top-right-radius: 0; border-bottom-right-radius: 0; padding: 8px 16px; }
QFrame#actionsFrame QPushButton#btnTriDate { border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: none; padding: 8px 16px; }
QFrame#actionsFrame QPushButton[actif="true"] { background: #1f2d3d; color: white; border-color: #1f2d3d; }
QFrame#actionsFrame QPushButton[actif="true"]:hover { background: #2d4157; }

/* ---- Bandeau (messages, Enregistrer / Annuler, confirmation, fiche) ---- */
QFrame#bandeau { background: white; border: 1px solid #e3e6ea; border-radius: 8px; }
QFrame#bandeau[etat="info"]    { background: #eff6ff; border-color: #bfdbfe; }
QFrame#bandeau[etat="ok"]      { background: #f0fdf4; border-color: #bbf7d0; }
QFrame#bandeau[etat="erreur"]  { background: #fef2f2; border-color: #fecaca; }
QFrame#bandeau[etat="edition"] { background: #fffbeb; border-color: #fde68a; }
QFrame#bandeau[etat="danger"]  { background: #fef2f2; border-color: #fca5a5; }
QFrame#bandeau QLabel { border: none; background: transparent; font-size: 13px; }
QFrame#bandeau[etat="info"]    QLabel { color: #1e3a8a; }
QFrame#bandeau[etat="ok"]      QLabel { color: #166534; }
QFrame#bandeau[etat="erreur"]  QLabel { color: #991b1b; }
QFrame#bandeau[etat="edition"] QLabel { color: #78350f; }
QFrame#bandeau[etat="danger"]  QLabel { color: #7f1d1d; }
QFrame#bandeau QPushButton {
    background: white; color: #374151; border: 1px solid #cfd4da; border-radius: 6px;
    padding: 8px 18px; font-weight: 700; min-height: 20px;
}
QFrame#bandeau QPushButton:hover   { background: #f3f4f6; }
QFrame#bandeau QPushButton:pressed { background: #e5e7eb; }
QFrame#bandeau QPushButton#btnBandeauOk { background: #15803d; color: white; border: 1px solid #15803d; }
QFrame#bandeau QPushButton#btnBandeauOk:hover   { background: #166534; }
QFrame#bandeau QPushButton#btnBandeauOk:pressed { background: #14532d; }
QFrame#bandeau[etat="danger"] QPushButton#btnBandeauOk { background: #b91c1c; border: 1px solid #b91c1c; }
QFrame#bandeau[etat="danger"] QPushButton#btnBandeauOk:hover { background: #991b1b; }

/* ---- Tableau ---- */
QFrame#tableFrame { background: white; border: 1px solid #e3e6ea; border-radius: 4px; }
QTableWidget { background: white; alternate-background-color: #f5f6f8; border: none; selection-background-color: #fde2e2; selection-color: #1f2937; }
QTableWidget::item { padding: 6px; border-bottom: 1px solid #e8eaee; }
QHeaderView { background: #1f2d3d; }
QHeaderView::section { background: #1f2d3d; color: white; font-weight: bold; padding: 12px 8px; border: none; border-right: 1px solid #2f4054; }
QTableCornerButton::section { background: #1f2d3d; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #c3c8d0; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

/* ---- Panneau de droite ---- */
QFrame#rightPanel { background: #eef0f4; border: none; }
QFrame#panelChat, QFrame#panelDispatch, QFrame#panelComm { background: white; border: 1px solid #e3e6ea; border-radius: 6px; }
QFrame#rightPanel QLabel { border: none; }
QLabel#panelChatTitle, QLabel#panelDispatchTitle, QLabel#panelCommTitle { font-weight: bold; font-size: 14px; }
QTextEdit#chatView { background: white; border: none; min-height: 110px; }
QFrame#rightPanel QLineEdit { background: white; border: 1px solid #d5d9df; border-radius: 4px; padding: 8px; }
QFrame#rightPanel QPushButton { background: #1f2d3d; color: white; border: none; border-radius: 5px; padding: 9px 16px; font-weight: bold; }
QFrame#rightPanel QPushButton:hover { background: #2d4157; }
QLabel#lblUniteChef, QLabel#lblDispo, QLabel#lblProgress, QLabel#lblEmail, QLabel#lblSms { color: #4b5563; font-size: 12px; }
QLabel#lblJour, QLabel#lblNuit, QLabel#lblWeekend { color: #4b5563; font-size: 12px; }

QProgressBar { background: #e5e7eb; border: none; border-radius: 5px; min-height: 10px; max-height: 10px; }
QProgressBar::chunk { background: #22a559; border-radius: 5px; }
QProgressBar#barWeekend::chunk, QProgressBar#barProgress::chunk { background: #d32f2f; }

QPushButton#btnNotifier { background: #dbeafe; color: #1d4ed8; font-weight: 600; padding: 9px 6px; }
QPushButton#btnAlerte   { background: #fee2e2; color: #dc2626; font-weight: 600; padding: 9px 6px; }
QFrame#rightPanel QPushButton#btnNotifier:hover { background: #c7dcfb; }
QFrame#rightPanel QPushButton#btnAlerte:hover   { background: #fbcfcf; }
QFrame#rightPanel QPushButton#btnNotifier { background: #dbeafe; color: #1d4ed8; padding: 9px 6px; }
QFrame#rightPanel QPushButton#btnAlerte   { background: #fee2e2; color: #dc2626; padding: 9px 6px; }
QFrame#rightPanel QPushButton#btnGenerer  { background: #26364a; }
QFrame#rightPanel QPushButton#btnEnvoyerEmail { background: #e53935; }
QFrame#rightPanel QPushButton#btnEnvoyerEmail:hover { background: #c62828; }
QFrame#rightPanel QPushButton#btnEnvoyerSms { background: #1f6fe0; }
QFrame#rightPanel QPushButton#btnEnvoyerWhatsapp { background: #22a559; }

/* ---- Édition directement dans le tableau ---- */
QFrame#celluleEdition { background: #fff7e0; border: none; }
QFrame#celluleEdition QLineEdit, QFrame#celluleEdition QDateEdit, QFrame#celluleEdition QTimeEdit,
QFrame#celluleEdition QComboBox {
    background: white; border: 1px solid #cfd4da; border-radius: 4px; padding: 5px 8px; min-width: 0; color: #1f2937;
}
QFrame#celluleEdition QLineEdit:focus, QFrame#celluleEdition QDateEdit:focus, QFrame#celluleEdition QTimeEdit:focus,
QFrame#celluleEdition QComboBox:focus { border: 1px solid #1f2d3d; }
QFrame#celluleEdition QLineEdit:disabled, QFrame#celluleEdition QDateEdit:disabled,
QFrame#celluleEdition QTimeEdit:disabled, QFrame#celluleEdition QComboBox:disabled { background: #f3f4f6; color: #6b7280; }
QFrame#celluleEdition QLineEdit[erreur="true"], QFrame#celluleEdition QDateEdit[erreur="true"],
QFrame#celluleEdition QTimeEdit[erreur="true"], QFrame#celluleEdition QComboBox[erreur="true"] {
    border: 1px solid #dc2626; background: #fef2f2;
}

/* ---- Statistiques (remplacent le tableau) ---- */
QLabel#lblStatsTitle { font-size: 16px; font-weight: bold; }
QLabel#lblParcoursTitle { font-size: 16px; font-weight: bold; }
QLabel#lblParcoursResume { font-weight: 600; color: #1f2937; }
QLabel#lblParcoursInfo { color: #6b7280; font-size: 12px; }
QLabel#lblAffectationTitle { font-size: 16px; font-weight: bold; }
QLabel#lblAffectationResume { font-weight: 600; color: #1f2937; }
QLabel#lblAffectationAvert { color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 8px 12px; }
QPushButton#btnValiderAffectation {
    background: #15803d; color: white; border: 1px solid #15803d; border-radius: 6px;
    padding: 8px 18px; font-weight: 700; min-height: 20px;
}
QPushButton#btnValiderAffectation:hover    { background: #166534; }
QPushButton#btnValiderAffectation:pressed  { background: #14532d; }
QPushButton#btnValiderAffectation:disabled { background: #a7c4b0; border-color: #a7c4b0; }
QFrame#statsFrame { background: white; border: 1px solid #e3e6ea; border-radius: 8px; }
QPushButton#btnRetourListe, QPushButton#btnRetourParcours, QPushButton#btnRetourAffectation {
    background: white; color: #1f2d3d; border: 1px solid #cfd4da; border-radius: 6px;
    padding: 8px 16px; font-weight: 600; min-height: 20px;
}
QPushButton#btnRetourListe:hover, QPushButton#btnRetourParcours:hover, QPushButton#btnRetourAffectation:hover   { background: #f3f4f6; border-color: #aab1bb; }
QPushButton#btnRetourListe:pressed, QPushButton#btnRetourParcours:pressed, QPushButton#btnRetourAffectation:pressed { background: #e5e7eb; }
</string></property>
