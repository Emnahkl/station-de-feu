  <property name="styleSheet">
   <string notr="true">QMainWindow { background: #F4F4F4; }
QWidget { font-size: 13px; color: #2B2B2B; }
#frame_sidebar { background: qlineargradient(x1:0, y1:0, x2:0.3, y2:1, stop:0 #4A0503, stop:0.55 #380404, stop:1 #350404); border-right: 1px solid #1A0202; }
#frame_sidebar QLabel { color: #FFFFFF; background: transparent; }
#label_logo { font-size: 22px; font-weight: 900; color: #FFFFFF; letter-spacing: 1px; }
#label_slogan { color: #F2D7D7; font-size: 10px; font-weight: bold; letter-spacing: 1px; }
#frame_sidebar QPushButton { color: #FFFFFF; background: transparent; border: none; text-align: left; padding: 11px 14px; border-radius: 8px; font-size: 14px; font-weight: 600; }
#frame_sidebar QPushButton:hover { background: rgba(255, 255, 255, 0.08); }
#frame_sidebar QPushButton:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #D3122A, stop:1 #A50E1F); border: 1px solid #E5394A; }
#frame_hero { border-image: url(:/campaign/images/sidebar_hero.jpg) 0 0 0 0 stretch stretch; }
#label_heroTitre { font-size: 20px; font-weight: bold; color: #FFFFFF; }
#label_heroSousTitre { font-size: 15px; font-weight: bold; color: #FFFFFF; }
#frame_heroTrait { background: #E53935; border-radius: 1px; }
QStatusBar { background: #1E2329; color: #C9CED6; border-top: 1px solid #111; }
QStatusBar QLabel { color: #C9CED6; font-size: 12px; padding: 2px 8px; }
#frame_header { background: #FFFFFF; border-bottom: 3px solid #C62828; }
#label_pageTitle { font-size: 20px; font-weight: bold; color: #C62828; }
#label_user { color: #555555; }
QGroupBox { background: #FFFFFF; border: 1px solid #E0E0E0; border-radius: 8px; margin-top: 18px; padding: 10px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #C62828; }
QLineEdit, QComboBox, QDateEdit, QSpinBox { background: #FFFFFF; border: 1px solid #BDBDBD; border-radius: 5px; padding: 5px; min-height: 22px; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus { border: 1px solid #FF6F00; }
QPushButton { background: #FF6F00; color: #FFFFFF; border: none; border-radius: 6px; padding: 8px 14px; font-weight: bold; }
QPushButton:hover { background: #E65100; }
QPushButton:disabled { background: #BDBDBD; }
#pushButton_ajouter { background: #2E7D32; }
#pushButton_ajouter:hover { background: #1B5E20; }
#pushButton_supprimer { background: #C62828; }
#pushButton_supprimer:hover { background: #8E0000; }
#pushButton_vider { background: #757575; }
QTableView, QTableWidget { background: #FFFFFF; border: 1px solid #E0E0E0; border-radius: 6px; gridline-color: #EEEEEE; selection-background-color: #FFE0B2; selection-color: #2B2B2B; }
QHeaderView::section { background: #C62828; color: #FFFFFF; padding: 6px; border: none; font-weight: bold; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: #E0E0E0; padding: 8px 18px; min-width: 130px; margin-right: 4px; border-top-left-radius: 6px; border-top-right-radius: 6px; }
QTabBar::tab:selected { background: #C62828; color: #FFFFFF; font-weight: bold; }
#label_zonePrioritaire { color: #C62828; font-weight: bold; }
#label_impactVerdict { font-weight: bold; }
#label_affichePreview { background: #FFFFFF; border: 2px dashed #BDBDBD; border-radius: 8px; color: #757575; }
#label_placeholder_dashboard, #label_placeholder_employes, #label_placeholder_vehicules, #label_placeholder_equipements, #label_placeholder_interventions, #label_placeholder_zones { color: #757575; font-size: 16px; }</string>
